#!/usr/bin/env ruby
# frozen_string_literal: true

require 'time'

FEEDS_PATH = 'feeds.yml'
BLACKLIST_PATH = 'blacklist.txt'
OUTPUT_DIR = 'public'
OUTPUT_PATH = File.join(OUTPUT_DIR, 'merged.xml')

MAX_ITEMS = 50

require_relative '../lib/stats'
require_relative '../lib/fusion_rss'
require_relative '../lib/feed_catalog'
require_relative '../lib/black_list'
require_relative '../lib/feed_source'
require_relative '../lib/filter'

def log(msg)
  puts "[main] #{msg}"
end

def process_entries(entries, fusion_rss, stats)
  entries.each do |entry|
    stats.item_fetched
    if entry.url_blank?
      stats.item_skipped_no_url
      next
    end

    fusion_rss.add(entry.to_fusion_entry)
  end
end

def process_feed(feed_source, fusion_rss, stats)
  entries = feed_source.fetch_entries
  stats.feed_succeeded

  log "Fetched #{feed_source.name} (#{feed_source.url}) entries=#{entries.length}"
  process_entries(entries, fusion_rss, stats)
rescue StandardError => e
  stats.feed_failed
  log "Feed fetch/parse failed: #{feed_source.name} #{feed_source.url} (#{e.class}: #{e.message})"
end

def main
  feed_catalog = FeedCatalog.new(FEEDS_PATH)
  blacklist = BlackList.new(BLACKLIST_PATH)
  stats = Stats.new(feeds_total: feed_catalog.length)

  log "Loaded #{feed_catalog.length} feeds"
  log "Loaded #{blacklist.length} blacklist rules"

  fusion_rss = FusionRss.new(Filter.new(blacklist), MAX_ITEMS)

  feed_catalog.each do |feed_source|
    process_feed(feed_source, fusion_rss, stats)
  end

  fusion_rss.finalize(stats)
  raise 'No feeds fetched successfully; aborting build' if stats.feeds_succeeded.zero?
  raise 'No items produced; aborting build' if stats.items_output.zero?

  fusion_rss.write(OUTPUT_PATH)

  stats.summary.each { |line| log "Summary #{line}" }
  log "Wrote #{OUTPUT_PATH}"
rescue FeedCatalog::ConfigFormatError => e
  log "Feed config load failed: #{FEEDS_PATH} (#{e.class}: #{e.message})"
  raise
end

main